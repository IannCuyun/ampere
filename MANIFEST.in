include docs/INSTALL.md
include CHANGELOG.md CONTRIBUTING.md docs/RELEASE.md
include README.md pyproject.toml requirements.lock THIRD_PARTY_NOTICES.md
recursive-include ampere *.py
recursive-include qml *.qml qmldir *.png *.frag *.qsb
include branding/icon-ampere.png
recursive-include packaging *.desktop *.xml *.service
recursive-include tests *.py *.qml *.json
prune design
prune debug
prune profiles
prune docs/overhaul
prune docs/verification
global-exclude __pycache__ *.pyc *.bak

# Internal design-governance checks require the private design archive.
exclude tests/test_design_provenance.py
